# PostgreSQL: use an URL-encoded password in DATABASE_URL.
POSTGRES_USER=jobsync
POSTGRES_PASSWORD=
POSTGRES_DB=jobsync
DATABASE_URL=postgresql://jobsync:CHANGE_ME@localhost:5432/jobsync?schema=public

# Generate with: openssl rand -base64 33
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Optional initial account; required only for first-time seeding.
USER_EMAIL=
USER_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
ML_SERVICE_URL=http://localhost:8000
ML_DEMO_MODE=false
